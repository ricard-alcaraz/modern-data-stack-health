{"data": {"conn_name": "model.mds_health.stg_github_issues", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "3888fad7bee95ee8a15d15a8cdaf8f405e115477159490ffde5109dae706d107", "node_finished_at": "", "node_name": "stg_github_issues", "node_path": "staging\\stg_github_issues.sql", "node_relation": {"alias": "stg_github_issues", "database": "mds_health_db", "relation_name": "\"mds_health_db\".\"main\".\"stg_github_issues\"", "schema": "main"}, "node_started_at": "2026-09-27T16:02:28.281189", "node_status": "executing", "resource_type": "model", "unique_id": "model.mds_health.stg_github_issues"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_issues\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_issues__dbt_tmp\" as (\n    \n\nwith combined as (\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'dbt-core' as tool_name\n    from \"mds_health_db\".\"raw\".\"dbt_core_issues\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'airflow' as tool_name\n    from \"mds_health_db\".\"raw\".\"airflow_issues\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'dagster' as tool_name\n    from \"mds_health_db\".\"raw\".\"dagster_issues\"\n    \n    \n\n),\n\n-- Filter out PRs (GitHub's /issues endpoint includes both) and deduplicate\ndeduplicated as (\n    select\n        *,\n        row_number() over (partition by id order by updated_at desc) as rn\n    from combined\n    where pull_request is null\n),\n\nrenamed as (\n    select\n        id as issue_id,\n        number as issue_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        tool_name\n    from deduplicated\n    where rn = 1\n)\n\nselect * from renamed\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "0e6b7af9-9c4f-4eea-9bde-2c72734e80ee", "level": "debug", "msg": "On model.mds_health.stg_github_issues: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_issues\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_issues__dbt_tmp\" as (\n    \n\nwith combined as (\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'dbt-core' as tool_name\n    from \"mds_health_db\".\"raw\".\"dbt_core_issues\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'airflow' as tool_name\n    from \"mds_health_db\".\"raw\".\"airflow_issues\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, closed_at, updated_at, user, pull_request,\n        'dagster' as tool_name\n    from \"mds_health_db\".\"raw\".\"dagster_issues\"\n    \n    \n\n),\n\n-- Filter out PRs (GitHub's /issues endpoint includes both) and deduplicate\ndeduplicated as (\n    select\n        *,\n        row_number() over (partition by id order by updated_at desc) as rn\n    from combined\n    where pull_request is null\n),\n\nrenamed as (\n    select\n        id as issue_id,\n        number as issue_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        tool_name\n    from deduplicated\n    where rn = 1\n)\n\nselect * from renamed\n  );\n", "name": "SQLQuery", "pid": 25032, "thread": "Thread-1 (worker)", "ts": "2026-09-27T16:02:28.608603Z"}}
