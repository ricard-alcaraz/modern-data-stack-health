{"data": {"conn_name": "model.mds_health.stg_github_pulls", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "5041e29727622c2b0fb700f89285dddc1186ee6fa16790fc404a49544fd780e8", "node_finished_at": "", "node_name": "stg_github_pulls", "node_path": "staging\\stg_github_pulls.sql", "node_relation": {"alias": "stg_github_pulls", "database": "mds_health_db", "relation_name": "\"mds_health_db\".\"main\".\"stg_github_pulls\"", "schema": "main"}, "node_started_at": "2026-09-27T16:02:29.038352", "node_status": "executing", "resource_type": "model", "unique_id": "model.mds_health.stg_github_pulls"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_pulls\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_pulls__dbt_tmp\" as (\n    \n\nwith combined as (\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'dbt-core' as tool_name\n    from \"mds_health_db\".\"raw\".\"dbt_core_pulls\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'airflow' as tool_name\n    from \"mds_health_db\".\"raw\".\"airflow_pulls\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'dagster' as tool_name\n    from \"mds_health_db\".\"raw\".\"dagster_pulls\"\n    \n    \n\n),\n\ndeduplicated as (\n    select\n        *,\n        row_number() over (partition by id order by updated_at desc) as rn\n    from combined\n),\n\nrenamed as (\n    select\n        id as pr_id,\n        number as pr_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        merged_at::timestamp as merged_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        tool_name\n    from deduplicated\n    where rn = 1\n)\n\nselect * from renamed\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "0e6b7af9-9c4f-4eea-9bde-2c72734e80ee", "level": "debug", "msg": "On model.mds_health.stg_github_pulls: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_pulls\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_pulls__dbt_tmp\" as (\n    \n\nwith combined as (\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'dbt-core' as tool_name\n    from \"mds_health_db\".\"raw\".\"dbt_core_pulls\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'airflow' as tool_name\n    from \"mds_health_db\".\"raw\".\"airflow_pulls\"\n    \n    union all\n    \n    \n    select\n        id, number, title, state, created_at, merged_at, closed_at, updated_at, user,\n        'dagster' as tool_name\n    from \"mds_health_db\".\"raw\".\"dagster_pulls\"\n    \n    \n\n),\n\ndeduplicated as (\n    select\n        *,\n        row_number() over (partition by id order by updated_at desc) as rn\n    from combined\n),\n\nrenamed as (\n    select\n        id as pr_id,\n        number as pr_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        merged_at::timestamp as merged_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        tool_name\n    from deduplicated\n    where rn = 1\n)\n\nselect * from renamed\n  );\n", "name": "SQLQuery", "pid": 25032, "thread": "Thread-1 (worker)", "ts": "2026-09-27T16:02:29.107306Z"}}
