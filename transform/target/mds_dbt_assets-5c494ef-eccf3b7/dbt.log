{"data": {"conn_name": "test.mds_health.assert_close_time_is_positive", "node_info": {"materialized": "test", "meta": {}, "node_checksum": "6c54866b1007081c335dcd79985919fa316e4cb8e1edbfd437acb6166e6e52bd", "node_finished_at": "", "node_name": "assert_close_time_is_positive", "node_path": "assert_close_time_is_positive.sql", "node_relation": {"alias": "assert_close_time_is_positive", "database": "mds_health_db", "relation_name": "", "schema": "main_dbt_test__audit"}, "node_started_at": "2026-09-27T16:02:29.718822", "node_status": "executing", "resource_type": "test", "unique_id": "test.mds_health.assert_close_time_is_positive"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"test.mds_health.assert_close_time_is_positive\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- Business rule: An issue cannot be closed before it is created.\n-- If this returns any rows, the test fails.\n\nselect \n    issue_id,\n    created_at,\n    closed_at,\n    datediff('day', created_at, closed_at) as close_time_days\nfrom \"mds_health_db\".\"main\".\"stg_github_issues\"\nwhere closed_at is not null \n  and datediff('day', created_at, closed_at) < 0\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "0e6b7af9-9c4f-4eea-9bde-2c72734e80ee", "level": "debug", "msg": "On test.mds_health.assert_close_time_is_positive: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"test.mds_health.assert_close_time_is_positive\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- Business rule: An issue cannot be closed before it is created.\n-- If this returns any rows, the test fails.\n\nselect \n    issue_id,\n    created_at,\n    closed_at,\n    datediff('day', created_at, closed_at) as close_time_days\nfrom \"mds_health_db\".\"main\".\"stg_github_issues\"\nwhere closed_at is not null \n  and datediff('day', created_at, closed_at) < 0\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 25032, "thread": "Thread-1 (worker)", "ts": "2026-09-27T16:02:29.875043Z"}}
