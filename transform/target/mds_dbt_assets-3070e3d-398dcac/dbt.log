{"data": {"conn_name": "model.mds_health.stg_github_issues", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "12b7be6537de8f319e1c17ae0b591034c86ef1933aaafb722e3cfb7fc2210e80", "node_finished_at": "", "node_name": "stg_github_issues", "node_path": "staging\\stg_github_issues.sql", "node_relation": {"alias": "stg_github_issues", "database": "mds_health_db", "relation_name": "\"mds_health_db\".\"main\".\"stg_github_issues\"", "schema": "main"}, "node_started_at": "2026-09-26T16:35:05.878812", "node_status": "executing", "resource_type": "model", "unique_id": "model.mds_health.stg_github_issues"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_issues\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_issues__dbt_tmp\" as (\n    -- Reads all JSONL files for dbt-core issues across all dates\n\n\nwith source as (\n    select * from read_json_auto('../data/landing/dbt-core/*/issues.jsonl')\n),\n\nrenamed as (\n    select\n        id as issue_id,\n        number as issue_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        pull_request is not null as is_pull_request,\n        'dbt-core' as tool_name\n    from source\n    where pull_request is null\n)\n\nselect * from renamed\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "5cdf80ed-2528-4d49-8f31-b745f185ae67", "level": "debug", "msg": "On model.mds_health.stg_github_issues: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_issues\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_issues__dbt_tmp\" as (\n    -- Reads all JSONL files for dbt-core issues across all dates\n\n\nwith source as (\n    select * from read_json_auto('../data/landing/dbt-core/*/issues.jsonl')\n),\n\nrenamed as (\n    select\n        id as issue_id,\n        number as issue_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        pull_request is not null as is_pull_request,\n        'dbt-core' as tool_name\n    from source\n    where pull_request is null\n)\n\nselect * from renamed\n  );\n", "name": "SQLQuery", "pid": 24928, "thread": "Thread-1 (worker)", "ts": "2026-09-26T16:35:05.919661Z"}}
