{"data": {"conn_name": "model.mds_health.stg_github_pulls", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "8607eb394395a2cb7d82ded8bb0316f11290129ce5892e746d15019eda7108b0", "node_finished_at": "", "node_name": "stg_github_pulls", "node_path": "staging\\stg_github_pulls.sql", "node_relation": {"alias": "stg_github_pulls", "database": "mds_health_db", "relation_name": "\"mds_health_db\".\"main\".\"stg_github_pulls\"", "schema": "main"}, "node_started_at": "2026-09-26T16:35:06.287532", "node_status": "executing", "resource_type": "model", "unique_id": "model.mds_health.stg_github_pulls"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_pulls\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_pulls__dbt_tmp\" as (\n    \n\nwith source as (\n    select * from read_json_auto('../data/landing/dbt-core/*/pulls.jsonl')\n),\n\nrenamed as (\n    select\n        id as pr_id,\n        number as pr_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        merged_at::timestamp as merged_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        'dbt-core' as tool_name\n    from source\n)\n\nselect * from renamed\n  );\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "5cdf80ed-2528-4d49-8f31-b745f185ae67", "level": "debug", "msg": "On model.mds_health.stg_github_pulls: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.stg_github_pulls\"} */\n\n  \n  create view \"mds_health_db\".\"main\".\"stg_github_pulls__dbt_tmp\" as (\n    \n\nwith source as (\n    select * from read_json_auto('../data/landing/dbt-core/*/pulls.jsonl')\n),\n\nrenamed as (\n    select\n        id as pr_id,\n        number as pr_number,\n        title,\n        state,\n        created_at::timestamp as created_at,\n        merged_at::timestamp as merged_at,\n        closed_at::timestamp as closed_at,\n        user.login as author_login,\n        'dbt-core' as tool_name\n    from source\n)\n\nselect * from renamed\n  );\n", "name": "SQLQuery", "pid": 24928, "thread": "Thread-1 (worker)", "ts": "2026-09-26T16:35:06.304345Z"}}
