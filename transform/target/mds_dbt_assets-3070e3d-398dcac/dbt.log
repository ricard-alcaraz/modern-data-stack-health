{"data": {"conn_name": "model.mds_health.fct_tool_weekly_snapshot", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "c42d97541655727019690ab3d68a64805b4c07c317d130ddff6be98727a783b1", "node_finished_at": "", "node_name": "fct_tool_weekly_snapshot", "node_path": "marts\\fct_tool_weekly_snapshot.sql", "node_relation": {"alias": "fct_tool_weekly_snapshot", "database": "mds_health_db", "relation_name": "\"mds_health_db\".\"main\".\"fct_tool_weekly_snapshot\"", "schema": "main"}, "node_started_at": "2026-09-26T16:35:10.702486", "node_status": "executing", "resource_type": "model", "unique_id": "model.mds_health.fct_tool_weekly_snapshot"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.fct_tool_weekly_snapshot\"} */\n\n    \n\n    create  table\n      \"mds_health_db\".\"main\".\"fct_tool_weekly_snapshot__dbt_tmp\"\n  \n    \n    as (\n      \n\nwith issues as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as issues_opened,\n        count_if(state = 'closed') as issues_closed,\n        avg(datediff('day', created_at, closed_at)) as avg_issue_close_time_days\n    from \"mds_health_db\".\"main\".\"stg_github_issues\"\n    group by 1, 2\n),\n\npulls as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as prs_opened,\n        count_if(merged_at is not null) as prs_merged\n    from \"mds_health_db\".\"main\".\"stg_github_pulls\"\n    group by 1, 2\n)\n\nselect\n    coalesce(i.tool_name, p.tool_name) as tool_name,\n    coalesce(i.week_start, p.week_start) as week_start,\n    coalesce(i.issues_opened, 0) as issues_opened,\n    coalesce(i.issues_closed, 0) as issues_closed,\n    round(coalesce(i.avg_issue_close_time_days, 0), 2) as avg_issue_close_time_days,\n    coalesce(p.prs_opened, 0) as prs_opened,\n    coalesce(p.prs_merged, 0) as prs_merged\nfrom issues i\nfull outer join pulls p \n    on i.tool_name = p.tool_name \n    and i.week_start = p.week_start\n    );\n    \n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "5cdf80ed-2528-4d49-8f31-b745f185ae67", "level": "debug", "msg": "On model.mds_health.fct_tool_weekly_snapshot: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.23\", \"profile_name\": \"mds_health\", \"target_name\": \"prod\", \"node_id\": \"model.mds_health.fct_tool_weekly_snapshot\"} */\n\n    \n\n    create  table\n      \"mds_health_db\".\"main\".\"fct_tool_weekly_snapshot__dbt_tmp\"\n  \n    \n    as (\n      \n\nwith issues as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as issues_opened,\n        count_if(state = 'closed') as issues_closed,\n        avg(datediff('day', created_at, closed_at)) as avg_issue_close_time_days\n    from \"mds_health_db\".\"main\".\"stg_github_issues\"\n    group by 1, 2\n),\n\npulls as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as prs_opened,\n        count_if(merged_at is not null) as prs_merged\n    from \"mds_health_db\".\"main\".\"stg_github_pulls\"\n    group by 1, 2\n)\n\nselect\n    coalesce(i.tool_name, p.tool_name) as tool_name,\n    coalesce(i.week_start, p.week_start) as week_start,\n    coalesce(i.issues_opened, 0) as issues_opened,\n    coalesce(i.issues_closed, 0) as issues_closed,\n    round(coalesce(i.avg_issue_close_time_days, 0), 2) as avg_issue_close_time_days,\n    coalesce(p.prs_opened, 0) as prs_opened,\n    coalesce(p.prs_merged, 0) as prs_merged\nfrom issues i\nfull outer join pulls p \n    on i.tool_name = p.tool_name \n    and i.week_start = p.week_start\n    );\n    \n  ", "name": "SQLQuery", "pid": 24928, "thread": "Thread-1 (worker)", "ts": "2026-09-26T16:35:10.733986Z"}}
