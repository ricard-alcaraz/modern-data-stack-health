m \"mds_health_db\".\"main\".\"stg_github_issues\"\n    group by 1, 2\n),\n\npulls as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as prs_opened,\n        count_if(merged_at is not null) as prs_merged\n    from \"mds_health_db\".\"main\".\"stg_github_pulls\"\n    group by 1, 2\n)\n\nselect\n    coalesce(i.tool_name, p.tool_name) as tool_name,\n    coalesce(i.week_start, p.week_start) as week_start,\n    coalesce(i.issues_opened, 0) as issues_opened,\n    coalesce(i.issues_closed, 0) as issues_closed,\n    round(coalesce(i.avg_issue_close_time_days, 0), 2) as avg_issue_close_time_days,\n    coalesce(p.prs_opened, 0) as prs_opened,\n    coalesce(p.prs_merged, 0) as prs_merged\nfrom issues i\nfull outer join pulls p \n    on i.tool_name = p.tool_name \n    and i.week_start = p.week_start", "relation_name": "\"mds_health_db\".\"main\".\"fct_tool_weekly_snapshot\"", "batch_results": null}], "elapsed_time": 7.979487419128418, "args": {"require_resource_names_without_spaces": true, "use_fast_test_edges": false, "state_modified_compare_vars": false, "version_check": true, "require_yaml_configuration_for_mf_time_spines": false, "show": false, "log_level_file": "debug", "source_freshness_run_project_hooks": true, "static_parser": true, "exclude": [], "require_explicit_package_overrides_for_builtin_materializations": true, "select": ["fqn:*"], "log_format": "json", "empty": false, "state_modified_compare_more_unrendered_values": false, "use_colors": true, "printer_width": 80, "require_generic_test_arguments_property": true, "introspect": true, "indirect_selection": "eager", "which": "build", "export_saved_queries": false, "include_saved_query": false, "skip_nodes_if_on_run_start_fails": false, "upload_to_artifacts_ingest_api": false, "cache_selected_only": false, "show_resource_report": false, "log_path": "C:\\Projects\\modern-data-stack-health\\transform\\target\\mds_dbt_assets-3070e3d-398dcac", "pr