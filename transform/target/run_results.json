\"stg_github_issues\"\n    group by 1, 2\n),\n\npulls as (\n    select\n        tool_name,\n        date_trunc('week', created_at) as week_start,\n        count_if(state = 'open') as prs_opened,\n        count_if(merged_at is not null) as prs_merged\n    from \"mds_health_db\".\"main\".\"stg_github_pulls\"\n    group by 1, 2\n)\n\nselect\n    coalesce(i.tool_name, p.tool_name) as tool_name,\n    coalesce(i.week_start, p.week_start) as week_start,\n    coalesce(i.issues_opened, 0) as issues_opened,\n    coalesce(i.issues_closed, 0) as issues_closed,\n    round(coalesce(i.avg_issue_close_time_days, 0), 2) as avg_issue_close_time_days,\n    coalesce(p.prs_opened, 0) as prs_opened,\n    coalesce(p.prs_merged, 0) as prs_merged\nfrom issues i\nfull outer join pulls p \n    on i.tool_name = p.tool_name \n    and i.week_start = p.week_start", "relation_name": "\"mds_health_db\".\"main\".\"fct_tool_weekly_snapshot\"", "batch_results": null}], "elapsed_time": 24.8534038066864, "args": {"static_parser": true, "require_explicit_package_overrides_for_builtin_materializations": true, "require_nested_cumulative_type_params": false, "log_file_max_bytes": 10485760, "use_colors": true, "require_all_warnings_handled_by_warn_error": false, "state_modified_compare_vars": false, "introspect": true, "require_generic_test_arguments_property": true, "send_anonymous_usage_stats": true, "log_format": "default", "write_json": true, "source_freshness_run_project_hooks": true, "favor_state": false, "show_all_deprecations": false, "profiles_dir": "C:\\Projects\\modern-data-stack-health\\transform", "resource_types": [], "show": false, "partial_parse": true, "quiet": false, "log_level_file": "debug", "exclude_resource_types": [], "indirect_selection": "eager", "macro_debugging": false, "empty": false, "exclude": [], "strict_mode": false, "select": [], "defer": false, "print": true, "show_resource_report": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "invocation_command": 